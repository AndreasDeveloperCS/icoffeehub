#!/usr/bin/env bash
# Reference copy of the script installed at /usr/local/sbin/deploy-icoffeehub-nginx
# on the deploy host, invoked via passwordless sudo from
# .github/workflows/deploy.yml ("Install and reload Nginx").
#
# It must live outside the rsync'd app directory and be owned by root,
# not the deploy runner user — that's what makes the sudoers NOPASSWD
# entry below safe: a compromised repo push can change this file, but
# can't change what root actually executes.
#
# One-time setup on the deploy host:
#   sudo cp scripts/deploy-icoffeehub-nginx /usr/local/sbin/deploy-icoffeehub-nginx
#   sudo chown root:root /usr/local/sbin/deploy-icoffeehub-nginx
#   sudo chmod 755 /usr/local/sbin/deploy-icoffeehub-nginx
#   echo '<runner-user> ALL=(root) NOPASSWD: /usr/local/sbin/deploy-icoffeehub-nginx' | \
#     sudo tee /etc/sudoers.d/deploy-icoffeehub-nginx
set -euo pipefail

# Must match the `APP_PATH` repo variable used by the deploy workflow.
APP_PATH="/var/www/icoffeehub"
CONF_NAME="icoffeehub.com.conf"

# A hand-written "icoffeehub.conf" (no ".com") was created directly on this
# host before this deploy pipeline existed. It declares the same
# `server_name icoffeehub.com`, so if it's still present nginx silently picks
# whichever of the two loads first and ignores the repo-managed one below.
# Remove it every deploy so it can never come back from a stale symlink.
rm -f "/etc/nginx/sites-available/icoffeehub.conf" "/etc/nginx/sites-enabled/icoffeehub.conf"

cp "$APP_PATH/nginx/$CONF_NAME" "/etc/nginx/sites-available/$CONF_NAME"
ln -sf "/etc/nginx/sites-available/$CONF_NAME" "/etc/nginx/sites-enabled/$CONF_NAME"

nginx -t
systemctl reload nginx
